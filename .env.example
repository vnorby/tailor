# Tailor server configuration. Copy to .env.local and fill in. Never commit .env.local.
# Every key here is yours: Tailor's server calls these services on your behalf.

# --- Required ---------------------------------------------------------------
# Claude, which powers the agent, home layout, themes and transaction explanations.
# https://console.anthropic.com  (usage is billed to this key)
ANTHROPIC_API_KEY=

# Solana RPC + token/transaction data. The free tier is enough. https://helius.dev
HELIUS_API_KEY=

# --- Optional ---------------------------------------------------------------
# Use your own RPC instead of Helius's for transactions/simulation.
# SOLANA_RPC_URL=

# Higher Jupiter rate limits. Without it Tailor uses the free lite-api.jup.ag.
# https://portal.jup.ag
JUPITER_API_KEY=

# tokens.xyz asset registry: tokenized stocks/ETFs/metals, "registered" checkmarks,
# curated lists for the agent. https://tokens.xyz
TOKENS_XYZ_API_KEY=

# Extra swap routes / prediction-market positions.
# TITAN_API_KEY=
# DFLOW_API_KEY=

# Buy-with-card on-ramp. Both keys required; the button is hidden without them.
# MOONPAY_PUBLISHABLE_KEY=
# MOONPAY_SECRET_KEY=

# Persist generated layouts in Postgres (e.g. Neon). Otherwise kept in memory.
# DATABASE_URL=

# Which browser extensions may call this server. Defaults to the ID fixed by the
# "key" in extension/public/manifest.json. Set this if you publish your own build
# (comma-separated IDs). "*" allows any extension and is not recommended.
# EXTENSION_IDS=
