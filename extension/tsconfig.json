{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"], "baseUrl": ".", "paths": { "@/*": ["../*"], "~/*": ["./src/*"] }, "allowImportingTsExtensions": false, "resolveJsonModule": true
  },
  "include": ["src"], "exclude": ["src/**/*.test.ts"]
}
